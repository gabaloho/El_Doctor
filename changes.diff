+            ("Silent", st.get("silent", 0), "st-silent"), ("Late", st.get("late", 0), "st-late"),
+            ("Critical open", sev.get("critical", 0), "sev-critical"), ("High open", sev.get("high", 0), "sev-high"),
+            ("Pending commands", ov["pending_commands"], "")])
