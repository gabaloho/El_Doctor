index 0000000..9b7f429
--- /dev/null
+++ b/El_Doctor/eldoctor/activity/report.py
@@ -0,0 +1,276 @@
+"""Reports for the registered administrators (e-mail), with a persistent outbox.
+
+Recipients are the e-mail addresses of the *registered* El Doctor administrators (role ``admin``, active,
+account record intact - a row added to the database behind the agent's back is never a recipient), plus
+``activity.report.extra_recipients``.  They are resolved when the mail is sent.
+
+SMTP settings: ``activity.report.smtp`` or, when empty, the first ``email`` notification channel.
+
+Every report is written to the ``outbox`` table *before* anything is sent, and retried with back-off
+until it is delivered - across agent restarts and reboots.  Queued and delivered reports are both
+recorded in the signed audit trail (``admin_report_queued`` / ``admin_report_sent``).
+"""
+from __future__ import annotations
+
+import base64
+import io
+import json
+import threading
+import time
+import zipfile
+from typing import Any, Dict, List, Optional
+
+from eldoctor.activity.wipe import CSV_FIELDS, human_bytes, rows_csv
+from eldoctor.models import HOSTNAME
+
+ATTRIBUTION_HELP = {
+    "kernel": "recorded by the operating system (auditd / Sysmon / Security log) - authoritative",
+    "handle": "the process had the file open",
+    "cmdline": "the process command line named the file or a parent folder",
+    "self": "El Doctor itself (quarantine)",
+    "inferred": "no process evidence - the home-folder owner / only logged-in user (a lead, not proof)",
+    "unknown": "no evidence of who did it",
+}
+
+
+def _t(ts: Any, fmt: str = "%Y-%m-%d %H:%M:%S") -> str:
+    try:
+        return time.strftime(fmt, time.localtime(float(ts)))
+    except (TypeError, ValueError):
+        return "?"
+
+
+class AdminReporter:
+    def __init__(self, cfg: Dict[str, Any], store, errors: Optional[Any] = None) -> None:
+        rc = ((cfg.get("activity") or {}).get("report") or {})
+        self.cfg = cfg
+        self.store = store
+        self.enabled = bool(rc.get("email_admins", True))
+        self.extra = [str(x) for x in rc.get("extra_recipients") or [] if x]
+        self.smtp_conf = dict(rc.get("smtp") or {})
+        self.max_attachment = float(rc.get("max_attachment_mb", 10)) * 1024 * 1024
+        self.retry_max = float(rc.get("retry_max_seconds", 6 * 3600))
+        self.body_rows = int(rc.get("body_rows", 100))
+        self.errors = errors if errors is not None else []
+        self._wake = threading.Event()
+        self._stop = threading.Event()
+        self._thread: Optional[threading.Thread] = None
+        self.sent = 0
+
+    # ------------------------------------------------------------------ configuration
+    def smtp(self) -> Optional[Dict[str, Any]]:
+        if self.smtp_conf.get("smtp_host"):
+            return self.smtp_conf
+        for ch in (self.cfg.get("notifications") or {}).get("channels") or []:
+            if ch.get("type") == "email" and ch.get("enabled", True) and ch.get("smtp_host"):
+                return ch
+        return None
+
+    def recipients(self) -> List[str]:
+        out: List[str] = []
+        for r in self.store.query("SELECT * FROM users WHERE role = 'admin' AND active = 1 ORDER BY id"):
+            if r.get("email") and self.store.user_row_ok(r):
+                out.append(str(r["email"]))
+        out += self.extra
+        seen, uniq = set(), []
+        for e in out:
+            if e.lower() not in seen:
+                seen.add(e.lower())
+                uniq.append(e)
+        return uniq
+
+    # ------------------------------------------------------------------ queue / deliver
+    def queue(self, kind: str, subject: str, body: str, attachments: Optional[List[Dict[str, Any]]] = None,
+              ref: str = "") -> Optional[str]:
+        if not self.enabled:
+            return None
+        enc = [{"name": a["name"], "mime": a.get("mime", "application/octet-stream"),
+                "data": base64.b64encode(a["data"]).decode()} for a in attachments or []]
+        oid = self.store.outbox_add(kind, subject, body, enc, ref)
+        self._wake.set()
+        return oid
+
+    def deliver(self, now: Optional[float] = None, force: bool = False) -> List[Dict[str, Any]]:
+        """Try every due report once.  Returns [{id, status, error}]."""
+        from eldoctor.notify.channels import ChannelError, send_email
+        now = now or time.time()
+        rows = self.store.query("SELECT * FROM outbox WHERE status = 'pending' ORDER BY ts") if force \
+            else self.store.outbox_due(now)
+        results = []
+        for r in rows:
+            conf = self.smtp()
+            to = self.recipients()
+            err = ""
+            if conf is None:
+                err = "no SMTP server configured (activity.report.smtp or an e-mail notification channel)"
+            elif not to:
+                err = "no registered administrator with an e-mail address"
+            else:
+                try:
+                    atts = [{"name": a["name"], "mime": a.get("mime"), "data": base64.b64decode(a["data"])}
+                            for a in json.loads(r["attachments"] or "[]")]
+                    send_email(conf, to, r["subject"], r["body"], atts)
+                except ChannelError as exc:
+                    err = str(exc)
+                except Exception as exc:             # never let a report crash the agent
+                    err = f"{type(exc).__name__}: {exc}"
+            attempts = int(r["attempts"] or 0) + 1
+            if err:
+                delay = min(self.retry_max, 60.0 * (2 ** min(attempts - 1, 12)))
+                self.store.outbox_update(r["id"], attempts=attempts, next_try=now + delay, last_error=err[:500])
+                msg = f"{time.strftime('%H:%M:%S')} admin report {r['id']}: {err}"
+                if not self.errors or self.errors[-1] != msg:
+                    self.errors.append(msg)
+                if attempts == 1:
+                    self.store.audit("agent", "admin_report_failed", {"id": r["id"], "error": err[:300]})
+            else:
+                self.store.outbox_update(r["id"], status="sent", attempts=attempts, sent_ts=time.time(),
+                                         last_error="", recipients=", ".join(to))
+                self.store.audit("agent", "admin_report_sent", {"id": r["id"], "kind": r["kind"], "recipients": to,
+                                                                "subject": r["subject"]})
+                self.sent += 1
+            results.append({"id": r["id"], "status": "failed" if err else "sent", "error": err})
+        return results
+
+    def start(self) -> None:
+        if self._thread or not self.enabled:
+            return
+        self._stop.clear()
+
+        def loop() -> None:
+            while not self._stop.is_set():
+                try:
+                    self.deliver()
+                except Exception as exc:
+                    self.errors.append(f"admin reports: {exc}")
+                self._wake.wait(30)
+                self._wake.clear()
+        self._thread = threading.Thread(target=loop, daemon=True, name="eldoctor-reports")
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+        self._wake.set()
+        if self._thread:
+            self._thread.join(timeout=5)
+            self._thread = None
+
+    # ------------------------------------------------------------------ report contents
+    def deletion_attachment(self, inc_summary: Dict[str, Any], rows: Optional[List[Dict[str, Any]]] = None
+                            ) -> Dict[str, Any]:
+        """Zipped CSV of every deleted file/folder of the incident (read back from the activity record)."""
+        buf = io.BytesIO()
+        written, truncated = 0, False
+        name = f"eldoctor-deleted-{HOSTNAME}-{inc_summary['id']}.csv"
+        with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as zf:
+            with zf.open(name, "w") as fh:
+                fh.write(rows_csv([]).encode())       # header
+                budget = self.max_attachment * 8      # paths compress ~8-10x
+                size = 0
+                for chunk in self._deletion_rows(inc_summary, rows):
+                    data = rows_csv(chunk).split("\n", 1)[1].encode()
+                    if size + len(data) > budget:
+                        truncated = True
+                        break
+                    fh.write(data)
+                    size += len(data)
+                    written += len(chunk)
+        return {"name": name + ".zip", "mime": "application/zip", "data": buf.getvalue(), "rows": written,
+                "truncated": truncated}
+
+    def _deletion_rows(self, s: Dict[str, Any], rows: Optional[List[Dict[str, Any]]]):
+        if rows is not None:
+            for i in range(0, len(rows), 5000):
+                yield rows[i:i + 5000]
+            return
+        after = int(s.get("first_id") or 0) - 1
+        last = int(s.get("last_id") or 0)
+        while after < last:
+            chunk = self.store.query("SELECT * FROM activity WHERE id > ? AND id <= ? AND kind = 'file_deleted' "
+                                     "ORDER BY id LIMIT 5000", (after, last))
+            if not chunk:
+                return
+            for r in chunk:
+                try:
+                    r["details"] = json.loads(r["details"]) if r.get("details") else {}
+                except ValueError:
+                    r["details"] = {}
+            yield chunk
+            after = int(chunk[-1]["id"])
+
+    def wipe_report(self, s: Dict[str, Any], alert: Dict[str, Any], sessions: List[Dict[str, Any]],
+                    sample: List[Dict[str, Any]], attachment: Dict[str, Any]) -> Dict[str, str]:
+        offline = s.get("source") == "offline"
+        actors = s.get("actors") or []
+        main = actors[0][0] if actors else "unknown"
+        procs = s.get("processes") or []
+        p0 = procs[0] if procs else None
+        sev = str(alert.get("severity", "critical")).upper()
+        what = f"{s['total']:,} files/folders deleted"
+        who = (" (actor not identified)" if main == "unknown" else f" by {main}") + \
+            (f" ({p0['process']}, pid {p0['pid']})" if p0 else "")
+        subject = (f"[El Doctor][{sev}] {'Files deleted while El Doctor was not running' if offline else 'Data wipe'}"
+                   f" on {HOSTNAME}: {what}{'' if offline and main == 'unknown' else who}")
+        L: List[str] = []
+        if offline:
+            g = s.get("gap") or [s["started"], s["last"]]
+            L += [f"El Doctor found {s['total']:,} files and folders missing when it started on {HOSTNAME}.",
+                  f"They were deleted while El Doctor was not running, between {_t(g[0])} and {_t(g[1])}",
+                  "(system shut down / rebooted, agent stopped, or the disk was accessed from another system).", ""]
+        else:
+            L += [f"El Doctor detected a mass deletion of files (possible data wipe) on {HOSTNAME}.", ""]
+        L += ["WHO"]
+        for name, n in actors[:10]:
+            L.append(f"  {name:<40} {n:>8,} item(s)")
+        for p in procs[:10]:
+            L.append(f"  process {p['process']} (pid {p['pid']}) {p.get('exe') or ''} - user {p.get('user') or '?'}"
+                     + (f", login user {p['login_user']}" if p.get("login_user") else "") + f" - {p['count']:,} item(s)")
+            if p.get("cmdline"):
+                L.append(f"    command line: {str(p['cmdline'])[:300]}")
+        L.append("  How each deletion was attributed:")
+        for how, n in sorted((s.get("attribution") or {}).items(), key=lambda x: -x[1]):
+            L.append(f"    {how:<9} {n:>8,}  - {ATTRIBUTION_HELP.get(how, '')}")
+        L.append("  Logged-in users " + ("before El Doctor stopped:" if offline else "at the time:"))
+        for x in sessions or []:
+            L.append(f"    {x.get('user')} ({x.get('type', '')} {x.get('terminal') or ''}"
+                     + (f" from {x['host']}" if x.get("host") else "") + f", since {_t(x.get('started'))})")
+        if not sessions:
+            L.append("    (none recorded)")
+        L += ["", "WHEN", f"  {_t(s['started'])}  ->  {_t(s['last'])}   ({s['duration_s']} s)"
+              + ("" if offline or s.get("closed") else "   (incident still open)"), "",
+              "WHAT",
+              f"  {s['files']:,} file(s) ({human_bytes(s['bytes'])}) and {s['folders']:,} folder(s); "
+              f"{s['permanent']:,} permanently deleted, {s['trashed']:,} moved to the Trash"]
+        if s.get("top_folders"):
+            L.append("  Folders most affected:")
+            for folder, n in s["top_folders"]:
+                L.append(f"    {n:>8,}  {folder}")
+        if s.get("deleted_folders"):
+            L.append("  Deleted folders:")
+            for f in s["deleted_folders"]:
+                L.append(f"    {f}")
+        L += ["", f"  First {min(len(sample), self.body_rows)} of {s['total']:,} deleted items "
+                  f"(complete list attached: {attachment['name']}, {attachment['rows']:,} rows"
+                  + (", TRUNCATED - run `eldoctor activity export` for everything" if attachment.get("truncated")
+                     else "") + "):"]
+        for d in sample[: self.body_rows]:
+            det = d.get("details") if isinstance(d.get("details"), dict) else {}
+            who_ = d.get("user") or "?"
+            if d.get("process"):
+                who_ += f"/{d['process']}[{d.get('pid') or '?'}]"
+            L.append(f"    {_t(d.get('ts'), '%H:%M:%S')}  {'folder' if d.get('is_dir') else 'file  '}  {d.get('path')}"
+                     + ("" if d.get("is_dir") or d.get("size") is None else f"  ({human_bytes(d.get('size'))})")
+                     + f"  by {who_}" + ("  [Trash]" if det.get("trashed") else ""))
+        L += ["", "RESPONSE / INVESTIGATION",
+              f"  Alert {alert.get('id')} - {alert.get('rule_id')} {alert.get('title')}",
+              f"  Timeline:  eldoctor activity list --since {int(s['started']) - 300} --kind file_deleted",
+              f"  Export:    eldoctor activity export --since {int(s['started']) - 300} --out triage.csv",
+              "  Response actions taken by playbooks: eldoctor actions",
+              "", "These records are kept in El Doctor's tamper-evident activity log (eldoctor audit verify).",
+              f"CSV columns: {', '.join(CSV_FIELDS)}"]
+        return {"subject": subject, "body": "\n".join(L)}
+
+    def simple_report(self, title: str, lines: List[str], alert: Optional[Dict[str, Any]] = None) -> Dict[str, str]:
+        sev = str((alert or {}).get("severity", "high")).upper()
+        body = "\n".join(lines + (["", f"Alert {alert.get('id')} - {alert.get('rule_id')}"] if alert else []))
+        return {"subject": f"[El Doctor][{sev}] {title} on {HOSTNAME}", "body": body}
diff --git a/El_Doctor/eldoctor/activity/rules.py b/El_Doctor/eldoctor/activity/rules.py
new file mode 100644
index 0000000..522f121
--- /dev/null
+++ b/El_Doctor/eldoctor/activity/rules.py
@@ -0,0 +1,19 @@
+"""Detection rules raised by the user-activity recorder (listed by `eldoctor rules`, silenced with
+detection.disabled_rules like every other rule)."""
+
+ACTIVITY_RULES = {
+    "ED-ACT-001": ("Mass file deletion (possible data wipe)", "critical", ["T1485", "T1070.004"],
+                   "Many files and folders were deleted in a short time. Wipers, ransomware and insiders destroying "
+                   "data look like this. The report lists who did it and every affected file."),
+    "ED-ACT-002": ("Files deleted while El Doctor was not running", "critical", ["T1485", "T1070.004"],
+                   "At start-up, files known to exist when El Doctor last ran were gone. The deletion happened "
+                   "while the agent was stopped or the system was off (or booted from other media)."),
+    "ED-ACT-003": ("El Doctor evidence store deleted or moved", "critical", ["T1070", "T1485"],
+                   "The El Doctor database, keys or logs disappeared from the data folder: someone is destroying "
+                   "the forensic record."),
+    "ED-ACT-004": ("Downloaded file matches threat intelligence", "critical", ["T1105", "T1204.002"],
+                   "A file that was just downloaded has a hash or name listed in a threat-intel feed."),
+    "ED-ACT-005": ("El Doctor stopped unexpectedly (monitoring gap)", "medium", ["T1562.001"],
+                   "The agent stopped without a clean shutdown while the system kept running - it may have been "
+                   "killed. Nothing was recorded during the gap."),
+}
diff --git a/El_Doctor/eldoctor/activity/scanner.py b/El_Doctor/eldoctor/activity/scanner.py
new file mode 100644
index 0000000..803d5e1
--- /dev/null
+++ b/El_Doctor/eldoctor/activity/scanner.py
@@ -0,0 +1,139 @@
+"""Snapshot-and-compare of the watched folders against the persisted ``file_index``.
+
+The comparison runs in SQLite (a TEMP table holds the fresh scan), so memory stays flat even for
+folders with hundreds of thousands of files.  Renames are recognised by inode (+ size for files), and
+the children of a renamed folder are folded into the folder's rename.
+"""
+from __future__ import annotations
+
+import os
+import threading
+from typing import Any, Callable, Dict, List, Optional, Sequence
+
+from eldoctor.activity.fswatch import PathFilter, walk
+
+SCAN_SCHEMA = """
+CREATE TEMP TABLE IF NOT EXISTS file_scan (
+    path TEXT PRIMARY KEY, root TEXT, is_dir INTEGER, size INTEGER, mtime_ns INTEGER, ino INTEGER
+);
+CREATE INDEX IF NOT EXISTS temp.idx_file_scan_ino ON file_scan(ino);
+"""
+
+
+class Scanner:
+    def __init__(self, store, flt: PathFilter, limit: int = 500_000, max_events: int = 200_000) -> None:
+        self.store = store
+        self.flt = flt
+        self.limit = int(limit)
+        self.max_events = int(max_events)
+        self.truncated = False
+        self.scanned = 0
+        self.lock = threading.Lock()        # one scan at a time (start-up diff, periodic poll, overflow rescan)
+
+    def _ensure(self) -> None:
+        with self.store._lock:
+            self.store.conn.executescript(SCAN_SCHEMA)
+
+    def scan(self, roots: Sequence[str], on_dir: Optional[Callable[[str], None]] = None) -> int:
+        """Walk the roots into temp.file_scan.  ``on_dir`` lets the inotify watcher add its watches during the
+        same walk (one pass over the disk)."""
+        self._ensure()
+        with self.store.tx() as c:
+            c.execute("DELETE FROM temp.file_scan")
+        counter = [0]
+        batch: List[tuple] = []
+        for root in roots:
+            if not os.path.isdir(root):
+                continue
+            for ent in walk(root, self.flt, on_dir=on_dir, limit=self.limit, counter=counter):
+                batch.append(ent)
+                if len(batch) >= 2000:
+                    self._flush(batch)
+            if counter[0] >= self.limit:
+                break
+        self._flush(batch)
+        self.scanned = counter[0]
+        self.truncated = counter[0] >= self.limit
+        return counter[0]
+
+    def _flush(self, batch: List[tuple]) -> None:
+        if not batch:
+            return
+        with self.store.tx() as c:
+            c.executemany("INSERT OR REPLACE INTO temp.file_scan (path, root, is_dir, size, mtime_ns, ino)"
+                          " VALUES (?,?,?,?,?,?)", batch)
+        batch.clear()
+
+    def diff(self, compare_roots: Sequence[str]) -> Dict[str, Any]:
+        """Changes between the persisted index and the fresh scan, for roots known to both.
+
+        Returns {created, deleted, modified, renamed: [row...], counts: {...}, truncated: bool}.  When the scan
+        hit the entry limit, deletions are *not* reported (unscanned files would look deleted)."""
+        roots = list(compare_roots)
+        out: Dict[str, Any] = {"created": [], "deleted": [], "modified": [], "renamed": [],
+                               "counts": {"created": 0, "deleted": 0, "modified": 0, "renamed": 0},
+                               "truncated": self.truncated}
+        if not roots:
+            return out
+        marks = ",".join("?" * len(roots))
+        q = self.store.query
+        lim = self.max_events + 1
+        renamed = q(f"""SELECT d.path AS path, s.path AS target, s.is_dir AS is_dir, s.size AS size, d.size AS old_size,
+                               s.root AS root
+                        FROM file_index d JOIN temp.file_scan s
+                             ON s.ino = d.ino AND s.is_dir = d.is_dir AND (d.is_dir = 1 OR s.size = d.size)
+                        WHERE d.root IN ({marks}) AND s.root IN ({marks}) AND d.ino != 0
+                          AND NOT EXISTS (SELECT 1 FROM temp.file_scan x WHERE x.path = d.path)
+                          AND NOT EXISTS (SELECT 1 FROM file_index y WHERE y.path = s.path)
+                        ORDER BY length(d.path) LIMIT ?""", (*roots, *roots, lim))
+        # fold children of renamed folders into the folder's rename; one source may pair with one target only
+        folded: List[Dict[str, Any]] = []
+        used_src, used_dst, dir_moves = set(), set(), []
+        for r in renamed:
+            if r["path"] in used_src or r["target"] in used_dst:
+                continue
+            parent = next(((o, n) for o, n in dir_moves if r["path"].startswith(o.rstrip(os.sep) + os.sep)), None)
+            used_src.add(r["path"])
+            used_dst.add(r["target"])
+            if parent and r["target"] == parent[1] + r["path"][len(parent[0]):]:
+                continue
+            if r["is_dir"]:
+                dir_moves.append((r["path"], r["target"]))
+            folded.append(r)
+        moved_old = [o for o, _ in dir_moves]
+        moved_new = [n for _, n in dir_moves]
+
+        def under(p: str, bases: List[str]) -> bool:
+            return any(p == b or p.startswith(b.rstrip(os.sep) + os.sep) for b in bases)
+
+        created = [r for r in q(f"""SELECT s.* FROM temp.file_scan s WHERE s.root IN ({marks})
+                                    AND NOT EXISTS (SELECT 1 FROM file_index i WHERE i.path = s.path)
+                                    ORDER BY s.path LIMIT ?""", (*roots, lim))
+                   if r["path"] not in used_dst and not under(r["path"], moved_new)]
+        deleted: List[Dict[str, Any]] = []
+        if not self.truncated:
+            deleted = [r for r in q(f"""SELECT i.* FROM file_index i WHERE i.root IN ({marks})
+                                        AND NOT EXISTS (SELECT 1 FROM temp.file_scan s WHERE s.path = i.path)
+                                        ORDER BY i.path LIMIT ?""", (*roots, lim))
+                       if r["path"] not in used_src and not under(r["path"], moved_old)]
+        modified = q(f"""SELECT s.*, i.size AS old_size, i.mtime_ns AS old_mtime_ns FROM temp.file_scan s
+                         JOIN file_index i ON i.path = s.path
+                         WHERE s.root IN ({marks}) AND s.is_dir = 0 AND (s.size != i.size OR s.mtime_ns != i.mtime_ns)
+                         ORDER BY s.path LIMIT ?""", (*roots, lim))
+        for key, rows in (("created", created), ("deleted", deleted), ("modified", modified), ("renamed", folded)):
+            out["counts"][key] = len(rows)
+            out[key] = rows[: self.max_events]
+        return out
+
+    def commit(self, c, roots: Sequence[str]) -> None:
+        """Make the fresh scan the new last-known state (called inside the transaction that records the
+        changes, so a crash can never record one without the other)."""
+        roots = list(roots)
+        if not roots:
+            return
+        marks = ",".join("?" * len(roots))
+        if self.truncated:              # partial scan: merge, never drop entries we did not get to
+            c.execute(f"INSERT OR REPLACE INTO file_index SELECT * FROM temp.file_scan WHERE root IN ({marks})", roots)
+        else:
+            c.execute(f"DELETE FROM file_index WHERE root IN ({marks})", roots)
+            c.execute(f"INSERT INTO file_index SELECT * FROM temp.file_scan WHERE root IN ({marks})", roots)
diff --git a/El_Doctor/eldoctor/activity/sessions.py b/El_Doctor/eldoctor/activity/sessions.py
new file mode 100644
index 0000000..9b9bc00
--- /dev/null
+++ b/El_Doctor/eldoctor/activity/sessions.py
@@ -0,0 +1,202 @@
+"""Who is logged in: live sessions (psutil - utmp on Linux/macOS, WTS on Windows), login history from
+wtmp (logins that happened while El Doctor was not running), and human-vs-service account checks."""
+from __future__ import annotations
+
+import os
+import re
+import struct
+import sys
+import time
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+import psutil
+
+IS_WINDOWS = sys.platform.startswith("win")
+SERVICE_ACCOUNTS_WIN = ("system", "local service", "network service", "nt authority\\system",
+                        "nt authority\\local service", "nt authority\\network service")
+SERVICE_PREFIX_WIN = ("dwm-", "umfd-", "window manager\\", "font driver host\\", "nt service\\", "iis apppool\\")
+_UID_MIN: Optional[int] = None
+_human_cache: Dict[str, bool] = {}
+
+
+def _uid_min() -> int:
+    global _UID_MIN
+    if _UID_MIN is None:
+        _UID_MIN = 1000
+        try:
+            with open("/etc/login.defs", encoding="utf-8", errors="replace") as fh:
+                for line in fh:
+                    m = re.match(r"^\s*UID_MIN\s+(\d+)", line)
+                    if m:
+                        _UID_MIN = int(m.group(1))
+        except OSError:
+            pass
+    return _UID_MIN
+
+
+def is_human(username: str) -> bool:
+    """A person's account (or root / Administrator), not a daemon / service identity."""
+    u = (username or "").strip()
+    if not u:
+        return False
+    if u in _human_cache:
+        return _human_cache[u]
+    low = u.lower()
+    if IS_WINDOWS or "\\" in u:
+        res = low not in SERVICE_ACCOUNTS_WIN and not low.startswith(SERVICE_PREFIX_WIN) and not low.endswith("$")
+    else:
+        try:
+            import pwd
+            uid = pwd.getpwnam(u).pw_uid
+        except (ImportError, KeyError):
+            uid = int(u) if u.isdigit() else -1
+        res = uid == 0 or (_uid_min() <= uid < 60000 and uid != 65534)
+    _human_cache[u] = res
+    return res
+
+
+def home_of(username: str) -> str:
+    try:
+        import pwd
+        return pwd.getpwnam(username).pw_dir
+    except (ImportError, KeyError):
+        pass
+    if IS_WINDOWS:
+        base = os.path.join(os.environ.get("SystemDrive", "C:") + os.sep, "Users")
+        return os.path.join(base, username.split("\\")[-1])
+    return ""
+
+
+def session_type(terminal: str, host: str) -> str:
+    t, h = (terminal or "").lower(), (host or "").strip()
+    if h and not h.startswith(":") and h not in ("localhost", "127.0.0.1", "::1"):
+        return "remote"
+    if re.match(r"^(tty\d+|console|:\d+(\.\d+)?|seat\d+|tty[a-z]?\d*)$", t) or h.startswith(":"):
+        return "console"
+    if t.startswith("pts"):
+        return "terminal"
+    return "local" if not t else "other"
+
+
+def session_key(s: Dict[str, Any]) -> str:
+    return f"{s.get('user')}|{s.get('terminal') or ''}|{s.get('host') or ''}|{int(float(s.get('started') or 0))}"
+
+
+def read_sessions(provider: Optional[Callable[[], List[Any]]] = None) -> List[Dict[str, Any]]:
+    try:
+        raw = (provider or psutil.users)()
+    except Exception:
+        return []
+    out = []
+    for u in raw:
+        d = u._asdict() if hasattr(u, "_asdict") else dict(u)
+        s = {"user": d.get("name") or d.get("user") or "", "terminal": d.get("terminal") or "",
+             "host": d.get("host") or "", "started": float(d.get("started") or 0), "pid": d.get("pid")}
+        s["type"] = session_type(s["terminal"], s["host"])
+        s["key"] = session_key(s)
+        out.append(s)
+    return out
+
+
+class SessionTracker:
+    """Diffs the OS session table each cycle: session_start / session_end."""
+
+    def __init__(self, provider: Optional[Callable[[], List[Any]]] = None) -> None:
+        self.provider = provider
+        self.open: Dict[str, Dict[str, Any]] = {}
+
+    def restore(self, previous: List[Dict[str, Any]], now: float, gap_start: float,
+                rebooted: bool) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
+        """Reconcile the sessions that were open when the agent last ran with the ones open now.
+
+        Returns (ended_while_down, started_while_down).  A session open before and after a reboot cannot be
+        the same one; a session that disappeared ended somewhere between ``gap_start`` and ``now``."""
+        current = {s["key"]: s for s in read_sessions(self.provider)}
+        prev = {s["key"]: s for s in previous or []}
+        ended, started = [], []
+        for k, s in prev.items():
+            if rebooted or k not in current:
+                ended.append(dict(s, ended_between=[gap_start, now], reason="system restarted" if rebooted
+                                  else "ended while El Doctor was not running"))
+        for k, s in current.items():
+            if rebooted or k not in prev:
+                started.append(s)
+        self.open = current
+        return ended, started
+
+    def poll(self) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
+        current = {s["key"]: s for s in read_sessions(self.provider)}
+        started = [s for k, s in current.items() if k not in self.open]
+        ended = [s for k, s in self.open.items() if k not in current]
+        self.open = current
+        return started, ended
+
+    def current(self) -> List[Dict[str, Any]]:
+        return sorted(self.open.values(), key=lambda s: s.get("started") or 0)
+
+    def users(self) -> List[str]:
+        return sorted({s["user"] for s in self.open.values() if s.get("user")})
+
+
+# --------------------------------------------------------------------------- wtmp (Linux / glibc layout)
+# struct utmp (bits/utmp.h, 64-bit and 32-bit glibc): 384 bytes
+UTMP = struct.Struct("<hxxi32s4s32s256shhiii4i20s")
+UT_TYPES = {1: "run_level", 2: "boot", 5: "init", 6: "login", 7: "user", 8: "dead"}
+
+
+def _cstr(b: bytes) -> str:
+    return b.split(b"\0", 1)[0].decode("utf-8", "replace")
+
+
+def read_wtmp(path: str = "/var/log/wtmp", since: float = 0.0, until: float = 0.0,
+              max_bytes: int = 64 * 1024 * 1024) -> List[Dict[str, Any]]:
+    """Login / logout / boot / shutdown records from wtmp between ``since`` and ``until``."""
+    out: List[Dict[str, Any]] = []
+    try:
+        size = os.path.getsize(path)
+        with open(path, "rb") as fh:
+            if size > max_bytes:                  # newest records only
+                fh.seek(size - (max_bytes // UTMP.size) * UTMP.size)
+            data = fh.read()
+    except OSError:
+        return out
+    for off in range(0, len(data) - UTMP.size + 1, UTMP.size):
+        (ut_type, pid, line, _id, user, host, _t, _e, _sess, sec, usec, _a0, _a1, _a2, _a3,
+         _unused) = UTMP.unpack_from(data, off)
+        ts = sec + usec / 1e6
+        if (since and ts < since) or (until and ts > until) or ut_type not in (1, 2, 7, 8):
+            continue
+        rec = {"ts": ts, "type": UT_TYPES[ut_type], "pid": pid, "line": _cstr(line), "user": _cstr(user),
+               "host": _cstr(host)}
+        if ut_type == 1 and rec["user"] == "shutdown":
+            rec["type"] = "shutdown"
+        elif ut_type == 1:
+            continue
+        out.append(rec)
+    return out
+
+
+def wtmp_sessions(records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """Pair wtmp USER_PROCESS / DEAD_PROCESS records into sessions (start, end, user, line, host)."""
+    open_by_line: Dict[str, Dict[str, Any]] = {}
+    out: List[Dict[str, Any]] = []
+    for r in sorted(records, key=lambda x: x["ts"]):
+        if r["type"] == "user":
+            s = {"user": r["user"], "terminal": r["line"], "host": r["host"], "started": r["ts"], "ended": None,
+                 "pid": r["pid"]}
+            s["type"] = session_type(s["terminal"], s["host"])
+            open_by_line[r["line"]] = s
+            out.append(s)
+        elif r["type"] == "dead" and r["line"] in open_by_line:
+            open_by_line.pop(r["line"])["ended"] = r["ts"]
+        elif r["type"] in ("boot", "shutdown"):
+            for s in open_by_line.values():
+                s["ended"] = r["ts"]
+                s["ended_by"] = r["type"]
+            open_by_line.clear()
+            out.append({"marker": r["type"], "ts": r["ts"]})
+    return out
+
+
+def now() -> float:
+    return time.time()
diff --git a/El_Doctor/eldoctor/activity/wipe.py b/El_Doctor/eldoctor/activity/wipe.py
new file mode 100644
index 0000000..984ac82
--- /dev/null
+++ b/El_Doctor/eldoctor/activity/wipe.py
@@ -0,0 +1,202 @@
+"""Data-wipe detection: bursts of deletions, grouped into incidents.
+
+A deletion burst opens an incident when ``threshold`` files/folders disappear within ``window`` seconds.
+The alarm is raised at that moment (while the wipe may still be running - the response playbook can
+suspend the process), deletions keep being attached to the incident, and when nothing has been deleted
+for ``quiet`` seconds the incident is closed and the complete report (who, what, how much) goes to the
+registered administrators.
+"""
+from __future__ import annotations
+
+import csv
+import io
+import os
+import time
+import uuid
+from collections import Counter, deque
+from dataclasses import dataclass, field
+from typing import Any, Deque, Dict, List, Optional, Tuple
+
+
+@dataclass
+class WipeIncident:
+    """Aggregates of one deletion burst.  Memory stays bounded whatever the size of the wipe: counters plus a
+    sample of rows; the complete list is read back from the activity table for the report attachment."""
+    id: str
+    started: float
+    last: float
+    source: str = "live"                   # live | offline (changes found at start-up)
+    alert_id: str = ""
+    closed: bool = False
+    gap: Optional[Tuple[float, float]] = None
+    sample_size: int = 2000
+    total: int = 0
+    files: int = 0
+    folders: int = 0
+    trashed: int = 0
+    bytes: int = 0
+    first_id: int = 0
+    last_id: int = 0
+    sample: List[Dict[str, Any]] = field(default_factory=list)
+    actors: Counter = field(default_factory=Counter)
+    how: Counter = field(default_factory=Counter)
+    parents: Counter = field(default_factory=Counter)
+    deleted_dirs: List[str] = field(default_factory=list)
+    procs: Dict[str, Dict[str, Any]] = field(default_factory=dict)
+
+    def add(self, d: Dict[str, Any]) -> None:
+        det = d.get("details") if isinstance(d.get("details"), dict) else {}
+        self.total += 1
+        ts = float(d.get("ts") or self.last)
+        self.last = max(self.last, ts)
+        self.started = min(self.started, ts)
+        rid = int(d.get("id") or 0)
+        if rid:
+            self.first_id = min(self.first_id or rid, rid)
+            self.last_id = max(self.last_id, rid)
+        if d.get("is_dir"):
+            self.folders += 1
+            if len(self.deleted_dirs) < 1000:
+                self.deleted_dirs.append(d.get("path") or "")
+        else:
+            self.files += 1
+            self.bytes += int(d.get("size") or 0)
+        if det.get("trashed"):
+            self.trashed += 1
+        who = d.get("user") or "unknown"
+        login = d.get("login_user") or ""
+        self.actors[who + (f" (login user {login})" if login and login != who else "")] += 1
+        self.how[d.get("attribution") or "unknown"] += 1
+        parent = os.path.dirname(d.get("path") or "")
+        if parent in self.parents or len(self.parents) < 50000:
+            self.parents[parent] += 1
+        if d.get("pid"):
+            k = f"{d.get('process')}[{d.get('pid')}]"
+            if k not in self.procs and len(self.procs) < 200:
+                self.procs[k] = {"pid": d.get("pid"), "process": d.get("process"), "exe": d.get("exe"),
+                                 "user": d.get("user"), "login_user": login, "count": 0,
+                                 "cmdline": det.get("cmdline", ""), "create_time": det.get("create_time", 0)}
+            if k in self.procs:
+                self.procs[k]["count"] += 1
+        if len(self.sample) < self.sample_size:
+            self.sample.append(d)
+
+    def summary(self, top: int = 15) -> Dict[str, Any]:
+        return {"id": self.id, "source": self.source, "started": self.started, "last": self.last,
+                "duration_s": round(max(0.0, self.last - self.started), 1), "total": self.total,
+                "files": self.files, "folders": self.folders, "trashed": self.trashed,
+                "permanent": self.total - self.trashed, "bytes": self.bytes, "actors": self.actors.most_common(),
+                "processes": sorted(self.procs.values(), key=lambda p: -p["count"]),
+                "attribution": dict(self.how), "top_folders": self.parents.most_common(top),
+                "deleted_folders": sorted(self.deleted_dirs)[:top], "gap": list(self.gap) if self.gap else None,
+                "closed": self.closed, "first_id": self.first_id, "last_id": self.last_id}
+
+    def primary_process(self) -> Optional[Dict[str, Any]]:
+        """The process responsible for most of the deletions, when it is known."""
+        procs = sorted(self.procs.values(), key=lambda p: -p["count"])
+        if procs and procs[0]["count"] >= max(1, self.total // 2):
+            return procs[0]
+        return None
+
+
+def _incident(rows: List[Dict[str, Any]], source: str = "live", gap=None) -> WipeIncident:
+    first = min(float(r.get("ts") or time.time()) for r in rows)
+    inc = WipeIncident(uuid.uuid4().hex[:10], first, first, source=source, gap=gap)
+    for r in rows:
+        inc.add(r)
+    return inc
+
+
+class WipeDetector:
+    def __init__(self, threshold: int = 50, window: float = 60.0, quiet: float = 20.0) -> None:
+        self.threshold = max(1, int(threshold))
+        self.window = float(window)
+        self.quiet = float(quiet)
+        self.recent: Deque[Dict[str, Any]] = deque()
+        self.current: Optional[WipeIncident] = None
+
+    def feed(self, deletions: List[Dict[str, Any]], now: Optional[float] = None) -> Optional[WipeIncident]:
+        """Add deletion rows; returns the incident when it has *just* been opened (raise the alarm)."""
+        now = now or time.time()
+        opened = None
+        for d in deletions:
+            ts = float(d.get("ts") or now)
+            if self.current is not None:
+                self.current.add(d)
+                continue
+            self.recent.append(d)
+            while self.recent and ts - float(self.recent[0].get("ts") or ts) > self.window:
+                self.recent.popleft()
+            if len(self.recent) >= self.threshold:
+                self.current = _incident(list(self.recent))
+                self.recent.clear()
+                opened = self.current
+        return opened
+
+    def poll(self, now: Optional[float] = None) -> Optional[WipeIncident]:
+        """The incident, once deletions have stopped for ``quiet`` seconds (send the final report)."""
+        now = now or time.time()
+        cur = self.current
+        if cur is not None and now - cur.last >= self.quiet:
+            cur.closed = True
+            self.current = None
+            return cur
+        while self.recent and now - float(self.recent[0].get("ts") or now) > self.window:
+            self.recent.popleft()
+        return None
+
+    def offline(self, deletions: List[Dict[str, Any]], gap: Tuple[float, float]) -> Optional[WipeIncident]:
+        """Deletions found at start-up (made while El Doctor was not running): one incident, already closed."""
+        if len(deletions) < self.threshold:
+            return None
+        inc = _incident(deletions, source="offline", gap=gap)
+        inc.closed = True
+        return inc
+
+
+CSV_FIELDS = ["time", "action", "type", "path", "new_path", "size_bytes", "user", "login_user", "pid", "process",
+              "exe", "attribution", "source", "trashed", "moved_out", "evidence"]
+
+
+def _iso(ts: Any) -> str:
+    try:
+        return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(float(ts)))
+    except (TypeError, ValueError):
+        return ""
+
+
+def csv_safe(v: Any) -> Any:
+    """File and process names are chosen by whoever created them: a name such as =HYPERLINK(...) would run as a
+    formula when an administrator opens the report in a spreadsheet (CSV injection)."""
+    if isinstance(v, str) and v[:1] in ("=", "+", "-", "@", "\t", "\r"):
+        return "'" + v
+    return v
+
+
+def rows_csv(rows: List[Dict[str, Any]]) -> str:
+    buf = io.StringIO()
+    w = csv.writer(buf)
+    w.writerow(CSV_FIELDS)
+    for r in rows:
+        det = r.get("details") or {}
+        if not isinstance(det, dict):
+            det = {}
+        w.writerow([csv_safe(x) for x in (
+            _iso(r.get("ts")), r.get("kind", ""), "folder" if r.get("is_dir") else "file", r.get("path", ""),
+            r.get("target", ""), "" if r.get("size") is None else r.get("size"), r.get("user", ""),
+            r.get("login_user", ""), r.get("pid") or "", r.get("process", ""), r.get("exe", ""),
+            r.get("attribution", ""), r.get("source", ""), "yes" if det.get("trashed") else "",
+            "yes" if det.get("moved_out") else "", det.get("evidence", ""))])
+    return buf.getvalue()
+
+
+def human_bytes(n: Any) -> str:
+    try:
+        n = float(n)
+    except (TypeError, ValueError):
+        return "?"
+    for unit in ("B", "KB", "MB", "GB", "TB"):
+        if n < 1024 or unit == "TB":
+            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
+        n /= 1024
+    return f"{n:.1f} TB"
