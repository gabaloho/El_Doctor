@@ -0,0 +1,18 @@
+id: pb-data-destruction
+name: Data destruction (mass deletion / wipe tools)
+description: >
+  A process is deleting many files (ED-ACT-001) or a secure-deletion / disk-wipe tool ran. Evidence first;
+  suspending the process stops the wipe and is reversible (resume it if the deletion was legitimate).
+  monitor: nothing is touched. interactive: the suspension waits for an analyst's approval.
+  enforce: suspended immediately. The full list of affected files is e-mailed to the registered admins
+  by the activity recorder whatever the mode.
+priority: 15
+exclusive: true
+trigger:
+  rule_ids: [ED-ACT-001, ED-ACT-003, "SIGMA:7c1e9a52-3b4d-4e6f-9a81-2d5c6e7f8a0*"]
+conditions:
+  - {field: alert.process.pid, op: exists}
+steps:
+  - {action: collect_forensics}
+  - {action: suspend}
+  - {action: notify, channels: [all], message: "Data-destruction playbook: process suspended (resume it if legitimate)."}
