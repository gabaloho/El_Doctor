+    def tick(self, log_events=None):
+        procs, new = self.col.snapshot()
+        self.alerts += self.mon.tick(procs, new, log_events or [])
+
+    def until(self, pred, timeout=15.0, step=0.25):
+        end = time.time() + timeout
+        while time.time() < end:
+            self.tick()
+            if pred():
