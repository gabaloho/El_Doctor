index 0000000..c90f2e6
--- /dev/null
+++ b/El_Doctor/.github/workflows/release.yml
@@ -0,0 +1,147 @@
+# Release: push a tag v<version> (it must match eldoctor/__init__.py) -> for people who just want to install:
+# the Windows setup wizard, the macOS disk image, Linux .deb / .rpm packages; for everyone else the standalone
+# executables (archives), the wheel + sdist; plus an SBOM, checksums and build provenance, on a GitHub Release.
+#
+# Every installer is tested by installing it on the runner: Windows silently per user and for all users with the
+# protection service (the administrator created by the wizard logs in to the running service), the .rpm in
+# AlmaLinux, the .deb on Ubuntu with `apt` + the systemd service, then removed again.
+#
+# Every executable is smoke-tested *as built* on its own OS by packaging/build_release.py (doctor, registration,
+# rules/playbooks bundled, a running agent recording file activity, audit chain verified, deployment bundle).
+# Linux is built inside AlmaLinux 8 so the binary runs on glibc 2.28+ (RHEL/Alma/Rocky 8+, Ubuntu 20.04+,
+# Debian 10+); the build fails if it would need a newer glibc.
+#
+# Optional code signing: set the ELDOCTOR_SIGN_CMD environment (e.g. from secrets) - it is run on every executable
+# before it is tested and archived, with {file} replaced by the executable's path.
+name: Release
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+permissions:
+  contents: read
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.12"}
+      - name: Tag matches the version
+        if: startsWith(github.ref, 'refs/tags/v')
+        run: |
+          v=$(python -c "import eldoctor; print(eldoctor.__version__)")
+          [ "v$v" = "${GITHUB_REF_NAME}" ] || { echo "tag ${GITHUB_REF_NAME} != version $v"; exit 1; }
+      - run: python -m pip install --require-hashes -r requirements.lock && python -m pip install pytest==9.2.0
+      - run: python -m pytest -q
+
+  linux:
+    needs: test
+    runs-on: ubuntu-latest
+    container: almalinux:8
+    steps:
+      - name: Build tools (Python 3.12 with Tk, glibc 2.28)
+        run: dnf install -y python3.12 python3.12-pip python3.12-tkinter binutils git tar gzip findutils rpm-build
+      - uses: actions/checkout@v4
+      - name: Build environment (locked dependencies)
+        run: |
+          git config --global --add safe.directory "$GITHUB_WORKSPACE"
+          python3.12 -m venv /opt/build
+          /opt/build/bin/pip install --upgrade pip
+          /opt/build/bin/pip install --require-hashes -r requirements.lock
+          /opt/build/bin/pip install -r packaging/requirements-build.txt
+      - name: Build + smoke test
+        run: /opt/build/bin/python packaging/build_release.py --skip-tests --python-dist --max-glibc 2.28 --require-gui --out release
+      - uses: actions/upload-artifact@v4
+        with: {name: release-linux, path: release/*}
+
+  linux-deb-test:
+    # the .deb the way an Ubuntu user installs it: apt, then whole-computer protection with systemd, then removal
+    needs: linux
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/download-artifact@v4
+        with: {name: release-linux, path: dist}
+      - name: Install with apt
+        run: |
+          sudo apt-get install -y ./dist/eldoctor_*_amd64.deb
+          eldoctor --version
+          test -f /usr/share/applications/eldoctor.desktop
+          eldoctor doctor
+      - name: Protect the whole computer (systemd service)
+        env: {P: "C1-Deb!Test-pw"}
+        run: |
+          sudo ELDOCTOR_ADMIN_USER=ci_admin ELDOCTOR_ADMIN_EMAIL=ci@example.invalid ELDOCTOR_ADMIN_PASSWORD="$P" \
+               eldoctor install-service --quiet
+          for i in $(seq 30); do systemctl is-active --quiet eldoctor && [ -S /run/eldoctor/api.sock ] && break; sleep 2; done
+          systemctl is-active eldoctor
+          eldoctor login --username ci_admin --password-env P
+          eldoctor whoami | grep -q service
+          eldoctor activity status
+      - name: Remove and purge
+        run: |
+          sudo apt-get remove -y eldoctor
+          if systemctl is-active --quiet eldoctor; then echo "the service survived the removal"; exit 1; fi
+          test ! -e /etc/systemd/system/eldoctor.service
+          test -d /var/lib/eldoctor               # records kept after remove
+          sudo apt-get purge -y eldoctor
+          test ! -e /var/lib/eldoctor
+
+  windows:
+    needs: test
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.12"}
+      - run: python -m pip install --require-hashes -r requirements.lock
+      - run: python -m pip install -r packaging/requirements-build.txt
+      - name: Inno Setup (setup wizard compiler)
+        shell: pwsh
+        run: |
+          if (-not (Test-Path "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe")) { choco install innosetup -y --no-progress }
+      - name: Build + smoke test (eldoctor.exe, "El Doctor.exe", ElDoctor-Setup.exe incl. service install/uninstall)
+        run: python packaging/build_release.py --skip-tests --require-gui --installer-service-test --out release
+      - uses: actions/upload-artifact@v4
+        with: {name: release-windows, path: release/*}
+
+  macos:
+    needs: test
+    runs-on: macos-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.12"}
+      - run: python -m pip install --require-hashes -r requirements.lock
+      - run: python -m pip install -r packaging/requirements-build.txt
+      - name: Build + smoke test
+        run: python packaging/build_release.py --skip-tests --require-gui --out release
+      - uses: actions/upload-artifact@v4
+        with: {name: release-macos, path: release/*}
+
+  publish:
+    needs: [linux, linux-deb-test, windows, macos]
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write          # create the release
+      id-token: write          # build provenance (Sigstore)
+      attestations: write
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/download-artifact@v4
+        with: {path: dist, merge-multiple: true}
+      - name: One checksum file for everything
+        run: |
+          cd dist
+          rm -f SHA256SUMS-*.txt
+          sha256sum eldoctor-* eldoctor_* ElDoctor-* > SHA256SUMS.txt
+          cat SHA256SUMS.txt
+      - uses: actions/attest-build-provenance@v2
+        with: {subject-path: "dist/*.*"}
+      - name: GitHub Release
+        if: startsWith(github.ref, 'refs/tags/v')
+        env: {GH_TOKEN: "${{ github.token }}"}
+        run: |
+          python3 packaging/release_notes.py "${GITHUB_REF_NAME#v}" "${{ github.repository }}" > notes.md
+          gh release create "$GITHUB_REF_NAME" dist/* --title "El Doctor ${GITHUB_REF_NAME#v}" --notes-file notes.md
