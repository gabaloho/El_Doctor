+# ------------------------------------------------------------------ sealing cadence: small chain, no loss, no blind spot
+def _seals(store):
+    return [json.loads(r["details"]) for r in store.list_audit(100000, include_bookkeeping=True)
+            if r["event"] == "activity_sealed"]
+
