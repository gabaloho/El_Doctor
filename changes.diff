@@ -0,0 +1,64 @@
+# Tests on every push / pull request.
+#   lint       - pyflakes on the package, tests and packaging scripts
+#   linux      - full suite on Python 3.9 ... 3.13; 3.11+ with the hash-locked dependencies that ship
+#   windows / macos - full suite.  Marked continue-on-error until their first green run: the Windows and macOS
+#               code paths have never been executed (docs/PRODUCTION_READINESS.md, P0-2). Remove the flag then.
+name: CI
+on:
+  push:
+  pull_request:
+permissions:
+  contents: read
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  lint:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.12"}
+      - run: python -m pip install pyflakes==3.4.0
+      - run: python -m pyflakes eldoctor tests packaging scripts
+
+  linux:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        python: ["3.9", "3.10", "3.11", "3.12", "3.13"]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "${{ matrix.python }}"}
+      - name: Dependencies (locked with hashes on 3.11+)
+        shell: bash
+        run: |
+          python -m pip install --upgrade pip
+          if python -c "import sys; sys.exit(sys.version_info < (3, 11))"; then
+            python -m pip install --require-hashes -r requirements.lock
+          else
+            python -m pip install .
+          fi
+          python -m pip install pytest==9.2.0
+      - run: python -m pytest -q
+      - name: El Doctor doctor
+        run: python -m eldoctor doctor
+
+  other-os:
+    runs-on: ${{ matrix.os }}
+    continue-on-error: true          # see the header: make this required after the first green run
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [windows-latest, macos-latest]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.12"}
+      - run: python -m pip install --require-hashes -r requirements.lock
+      - run: python -m pip install pytest==9.2.0
+      - run: python -m pytest -q
+      - run: python -m eldoctor doctor
