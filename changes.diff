+@pytest.fixture
+def agent(cfg, store):
+    from eldoctor.agent import Agent
+    from eldoctor.auth.users import UserManager
+    user, _ = UserManager(store, cfg).register("localadmin", PW, "l@example.invalid")
+    a = Agent(cfg, store, user, mode="monitor")
+    yield a
+    a.dispatcher.close()
