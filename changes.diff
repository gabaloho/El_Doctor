@@ -0,0 +1,22 @@
+title: Secure Deletion or Disk Wipe Tool Executed
+id: 7c1e9a52-3b4d-4e6f-9a81-2d5c6e7f8a01
+status: stable
+description: >
+  A tool that overwrites file contents (shred, wipe, srm, nwipe, scrub...) ran, or a block device was
+  overwritten / reformatted / discarded (dd of=/dev/..., wipefs, blkdiscard, mkfs), or rm -rf targeted the
+  root, home or system folders. Data destruction or evidence removal; the activity record shows which
+  files were affected and by whom.
+author: El Doctor
+tags: [attack.impact, attack.t1485, attack.t1561.001, attack.defense-evasion, attack.t1070.004]
+logsource: {category: process_creation, product: linux}
+detection:
+  sel_tools:
+    Image|endswith: ['/shred', '/wipe', '/srm', '/sfill', '/sswap', '/smem', '/nwipe', '/scrub', '/bleachbit']
+  sel_disk:
+    CommandLine|re: '(\bdd\b.*\bof=/dev/(sd|nvme|vd|xvd|hd|mmcblk|dm-|md|mapper/)|\b(wipefs|blkdiscard)\b.*(/dev/|\s-a\b|--all)|\bmkfs(\.\w+)?\s.*/dev/(sd|nvme|vd|xvd|hd|mmcblk|dm-|md|mapper/))'
+  sel_rm_root:
+    CommandLine|re: '\brm\s+(-\w*\s+)*-\w*(r\w*f|f\w*r)\w*\s+(-\S+\s+)*(/|/\*|/home/?\*?|/home/[^/\s]+/?\*?|~/?\*?|\$HOME/?\*?|/root/?\*?|/etc/?|/var/?|/srv/?|/opt/?|/boot/?|/usr/?)(\s|$)'
+  condition: 1 of sel_*
+falsepositives:
+  - Deliberate disk re-provisioning by administrators
+level: high
